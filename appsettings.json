{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=InscriptionAppDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Smtp": {
    "Enabled": false,
    "Provider": "Smtp",
    "MaxRetryAttempts": 3,
    "MaxEmailsPerMinute": 30,
    "Host": "smtp.example.com",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "SenderAddress": "no-reply@inscriptionapp.local"
  }
}